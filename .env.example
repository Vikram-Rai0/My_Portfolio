# ---------- Database (PostgreSQL: Neon, Supabase or Railway) ----------
# Runtime connection. On Neon/Supabase use the POOLED connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Optional: direct (non-pooled) URL used only by `prisma migrate`.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---------- Site ----------
# Public URL, used for canonical URLs, sitemap, OpenGraph and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Admin login (single admin) ----------
ADMIN_EMAIL="you@example.com"
# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH_B64=""
# Random string, at least 32 characters. e.g. `openssl rand -base64 48`
AUTH_SECRET=""

# ---------- Image uploads (Vercel Blob) ----------
# Vercel dashboard -> Storage -> Blob -> create store -> copy the token.
BLOB_READ_WRITE_TOKEN=""

# ---------- Contact email notification (optional, Resend) ----------
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
# Must be a sender allowed by your Resend domain, e.g. "Portfolio <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=""

# ---------- GitHub section (optional) ----------
# Raises the GitHub API limit from 60 to 5000 requests/hour. No scopes needed.
GITHUB_TOKEN=""

# ---------- Manual revalidation endpoint ----------
# POST /api/revalidate with header "x-revalidate-secret: <this value>"
REVALIDATE_SECRET=""
